<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Ask Dispatch — The Daily Dispatch</title>
<meta name="description" content="Ask Dispatch anything about what's happening in the world — science, sports, history, current events, explained simply.">

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Nunito:wght@400;600;700;800;900&family=Nunito+Sans:wght@400;600;700&display=swap" rel="stylesheet">

<style>
  :root {
    --cream: #FFFCF7;
    --white: #FFFFFF;
    --ink: #18181B;
    --ink-soft: #52525B;
    --ink-dim: #A1A1AA;
    --border: #E4E4E7;
    --font-display: 'Nunito', sans-serif;
    --font-body: 'Nunito Sans', sans-serif;
    --radius: 18px;
  }

  * { box-sizing: border-box; margin: 0; padding: 0; }
  html { scroll-behavior: smooth; height: 100%; }
  body { background: var(--cream); color: var(--ink); font-family: var(--font-body); line-height: 1.6; -webkit-font-smoothing: antialiased; min-height: 100vh; display: flex; flex-direction: column; }
  a { color: inherit; text-decoration: none; }

  /* HEADER */
  header { background: var(--white); border-bottom: 1px solid var(--border); position: relative; overflow: hidden; flex-shrink: 0; }
  header::before { content: ""; position: absolute; top: 0; left: 0; right: 0; height: 5px; background: linear-gradient(90deg, #F97316 0%, #EC4899 25%, #7C3AED 50%, #3B82F6 75%, #16A34A 100%); }
  .header-inner { max-width: 740px; margin: 0 auto; padding: 22px 20px 18px; }
  .masthead { display: flex; align-items: flex-start; justify-content: space-between; gap: 12px; }
  .logo-group { display: flex; align-items: center; gap: 14px; }
  .logo-mark { width: 56px; height: 56px; border-radius: 16px; background: linear-gradient(135deg, #F97316 0%, #DB2777 50%, #7C3AED 100%); display: flex; align-items: center; justify-content: center; font-size: 28px; flex-shrink: 0; box-shadow: 0 4px 12px rgba(249,115,22,0.3); }
  .logo-title { font-family: var(--font-display); font-size: clamp(20px, 5.5vw, 30px); font-weight: 900; line-height: 1; letter-spacing: -0.5px; }
  .logo-title .daily { color: #F97316; }
  .logo-tagline { font-family: var(--font-display); font-size: 13px; font-weight: 700; color: var(--ink-soft); margin-top: 4px; }
  .header-nav { display: flex; gap: 6px; align-items: center; flex-shrink: 0; padding-top: 6px; }
  .nav-link { font-family: var(--font-display); font-size: 13px; font-weight: 800; color: var(--ink-soft); padding: 7px 14px; border-radius: 100px; border: 2px solid transparent; transition: all 0.15s; }
  .nav-link:hover { background: var(--cream); border-color: var(--border); }
  .nav-link.active { color: #F97316; border-color: #FDBA74; background: #FFF7ED; }

  /* MAIN CHAT AREA */
  .chat-page { flex: 1; display: flex; flex-direction: column; max-width: 740px; margin: 0 auto; width: 100%; padding: 24px 20px 0; }

  /* HERO */
  .dispatch-hero { text-align: center; padding: 24px 0 28px; }
  .hero-avatar { width: 80px; height: 80px; border-radius: 24px; background: linear-gradient(135deg, #F97316, #DB2777, #7C3AED); display: flex; align-items: center; justify-content: center; font-size: 40px; margin: 0 auto 16px; box-shadow: 0 8px 24px rgba(249,115,22,0.25); }
  .hero-title { font-family: var(--font-display); font-size: clamp(24px, 6vw, 34px); font-weight: 900; color: var(--ink); margin-bottom: 8px; }
  .hero-title span { color: #F97316; }
  .hero-sub { font-family: var(--font-display); font-size: 15px; font-weight: 700; color: var(--ink-soft); max-width: 46ch; margin: 0 auto; line-height: 1.5; }

  /* SUGGESTION BUBBLES */
  .suggestions { display: flex; flex-wrap: wrap; gap: 8px; justify-content: center; margin-bottom: 24px; }
  .suggestion-btn { font-family: var(--font-display); font-size: 13px; font-weight: 700; background: var(--white); border: 2px solid var(--border); border-radius: 100px; padding: 9px 16px; cursor: pointer; color: var(--ink-soft); transition: all 0.18s ease; white-space: nowrap; }
  .suggestion-btn:hover { background: #FFF7ED; border-color: #F97316; color: #C2410C; transform: translateY(-2px); }

  /* CHAT WINDOW */
  .chat-window { background: var(--white); border: 2px solid var(--border); border-radius: var(--radius); flex: 1; display: flex; flex-direction: column; margin-bottom: 20px; overflow: hidden; min-height: 360px; }

  .chat-messages { flex: 1; overflow-y: auto; padding: 20px; display: flex; flex-direction: column; gap: 14px; }

  /* welcome message */
  .welcome-msg { display: flex; gap: 12px; align-items: flex-start; }
  .welcome-avatar { width: 36px; height: 36px; border-radius: 12px; background: linear-gradient(135deg, #F97316, #7C3AED); display: flex; align-items: center; justify-content: center; font-size: 18px; flex-shrink: 0; margin-top: 2px; }
  .welcome-bubble { background: #FFF7ED; border: 2px solid #FDBA74; border-radius: 4px 18px 18px 18px; padding: 14px 18px; font-family: var(--font-display); font-size: 15px; font-weight: 700; color: var(--ink); line-height: 1.6; max-width: calc(100% - 52px); }

  .msg-ai-wrap { display: flex; gap: 12px; align-items: flex-start; }
  .msg-ai-avatar { width: 36px; height: 36px; border-radius: 12px; background: linear-gradient(135deg, #F97316, #7C3AED); display: flex; align-items: center; justify-content: center; font-size: 18px; flex-shrink: 0; margin-top: 2px; }
  .msg-ai-bubble { background: var(--white); border: 2px solid var(--border); border-radius: 4px 18px 18px 18px; padding: 12px 16px; font-family: var(--font-display); font-size: 14px; font-weight: 700; color: var(--ink); line-height: 1.65; max-width: calc(100% - 52px); }

  .msg-user-wrap { display: flex; justify-content: flex-end; }
  .msg-user-bubble { background: #F97316; border-radius: 18px 4px 18px 18px; padding: 12px 16px; font-family: var(--font-display); font-size: 14px; font-weight: 700; color: white; line-height: 1.65; max-width: 78%; }

  .typing-wrap { display: flex; gap: 12px; align-items: flex-start; }
  .typing-bubble { background: var(--white); border: 2px solid var(--border); border-radius: 4px 18px 18px 18px; padding: 14px 18px; display: inline-flex; gap: 6px; align-items: center; }
  .typing-bubble span { width: 8px; height: 8px; border-radius: 50%; background: #D4D4D8; animation: bounce 1.2s infinite; }
  .typing-bubble span:nth-child(2) { animation-delay: 0.2s; }
  .typing-bubble span:nth-child(3) { animation-delay: 0.4s; }
  @keyframes bounce { 0%,80%,100% { transform: scale(0.7); opacity: 0.4; } 40% { transform: scale(1.1); opacity: 1; } }

  /* INPUT BAR */
  .input-bar { border-top: 2px solid var(--border); padding: 16px 20px; background: var(--white); display: flex; gap: 10px; align-items: flex-end; }
  .chat-input { flex: 1; font-family: var(--font-display); font-size: 15px; font-weight: 700; color: var(--ink); background: var(--cream); border: 2px solid var(--border); border-radius: 100px; padding: 12px 20px; outline: none; transition: border-color 0.15s; resize: none; line-height: 1.5; max-height: 100px; overflow-y: auto; }
  .chat-input:focus { border-color: #F97316; background: var(--white); }
  .chat-input::placeholder { color: var(--ink-dim); font-weight: 600; }
  .send-btn { font-family: var(--font-display); font-size: 14px; font-weight: 900; background: #F97316; color: white; border: none; border-radius: 100px; padding: 12px 24px; cursor: pointer; transition: all 0.15s; white-space: nowrap; flex-shrink: 0; }
  .send-btn:hover { background: #EA6C0A; transform: scale(1.03); }
  .send-btn:disabled { background: #D4D4D8; cursor: not-allowed; transform: none; }

  .chat-note { text-align: center; font-family: var(--font-display); font-size: 12px; font-weight: 700; color: var(--ink-dim); padding: 0 20px 16px; }

  @media (prefers-reduced-motion: reduce) { * { transition: none !important; animation: none !important; } }
</style>
</head>
<body>

<header>
  <div class="header-inner">
    <div class="masthead">
      <div class="logo-group">
        <div class="logo-mark">📰</div>
        <div>
          <div class="logo-title">THE <span class="daily">DAILY</span> DISPATCH</div>
          <div class="logo-tagline">News for curious minds ✨</div>
        </div>
      </div>
      <nav class="header-nav">
        <a href="index.html" class="nav-link">Feed</a>
        <a href="askdispatch.html" class="nav-link active">Ask Dispatch</a>
        <a href="about.html" class="nav-link">About</a>
      </nav>
    </div>
  </div>
</header>

<div class="chat-page">

  <div class="dispatch-hero">
    <div class="hero-avatar">📰</div>
    <div class="hero-title">Ask <span>Dispatch</span> Anything</div>
    <div class="hero-sub">Curious about what's happening in the world? Ask me! I'll explain it simply and clearly.</div>
  </div>

  <div class="suggestions" id="suggestions">
    <button class="suggestion-btn" onclick="ask('Why do countries have wars?')">🌍 Why do countries have wars?</button>
    <button class="suggestion-btn" onclick="ask('How does a rocket go to space?')">🚀 How does a rocket go to space?</button>
    <button class="suggestion-btn" onclick="ask('What is the Parliament of India?')">🏛️ What is Parliament?</button>
    <button class="suggestion-btn" onclick="ask('Why is the monsoon important for India?')">🌧️ Why is monsoon important?</button>
    <button class="suggestion-btn" onclick="ask('What is happening in India right now?')">📰 What is happening in India?</button>
    <button class="suggestion-btn" onclick="ask('How do elections work?')">🗳️ How do elections work?</button>
    <button class="suggestion-btn" onclick="ask('What is climate change?')">🌱 What is climate change?</button>
    <button class="suggestion-btn" onclick="ask('Who is the Prime Minister of India and what do they do?')">👤 Who is India's Prime Minister?</button>
    <button class="suggestion-btn" onclick="ask('Why do we have different countries?')">🗺️ Why do we have countries?</button>
    <button class="suggestion-btn" onclick="ask('What is the United Nations?')">🕊️ What is the United Nations?</button>
  </div>

  <div class="chat-window">
    <div class="chat-messages" id="messages">
      <div class="welcome-msg">
        <div class="welcome-avatar">📰</div>
        <div class="welcome-bubble">
          Hi! I am Ask Dispatch — your friendly news and world explainer. 👋<br><br>
          Ask me anything! Why is something happening in the news? What is a country? How does the government work? What is a war? Why is science important?<br><br>
          No question is too big or too small. Go ahead — ask away! ✨
        </div>
      </div>
    </div>
    <div class="input-bar">
      <input class="chat-input" id="chat-input" type="text"
        placeholder="Ask me anything about the world..."
        onkeydown="if(event.key==='Enter') sendMessage()">
      <button class="chat-send send-btn" id="send-btn" onclick="sendMessage()">Send ✈️</button>
    </div>
  </div>
  <div class="chat-note">💡 Ask Dispatch explains things simply. Always ask your teacher too for more details!</div>

</div>

<script>
  const WORKER_URL = 'YOUR_CLOUDFLARE_WORKER_URL_HERE';

  const SYSTEM = `You are Ask Dispatch, a warm and enthusiastic world explainer for curious young readers.
Your job is to answer any question about the world — current events, history, science, geography, politics, nature, sports, culture — in simple, clear, engaging language.
RULES:
- No markdown at all — plain sentences only. No asterisks, hashtags, or dashes for bullets.
- Use simple everyday words. If you must use a difficult word, explain it immediately in simple terms.
- Be warm, enthusiastic and encouraging. Make learning feel like an adventure.
- Keep answers focused — 4-6 sentences for simple questions, a bit more for complex ones.
- If asked about something very recent that you might not know about, say so honestly.
- Never discuss violence in graphic detail, or anything inappropriate for young readers.
- Use relatable comparisons to everyday life where possible.
- End by inviting a follow-up question if the topic has more to explore.`;

  const history = [];

  async function ask(question) {
    document.getElementById('suggestions').style.display = 'none';
    document.getElementById('chat-input').value = question;
    await sendMessage();
  }

  async function sendMessage() {
    const input = document.getElementById('chat-input');
    const sendBtn = document.getElementById('send-btn');
    const text = input.value.trim();
    if (!text) return;

    input.value = '';
    input.disabled = true;
    sendBtn.disabled = true;

    document.getElementById('suggestions').style.display = 'none';
    addUserMsg(text);
    addTyping();

    history.push({ role: 'user', content: text });

    const reply = await callWorker(history, SYSTEM);
    history.push({ role: 'assistant', content: reply });

    removeTyping();
    addAiMsg(reply);

    input.disabled = false;
    sendBtn.disabled = false;
    input.focus();
  }

  async function callWorker(messages, system) {
    if (!WORKER_URL || WORKER_URL === 'https://soft-scene-602a.kiyaan-rathod31.workers.dev/') {
      return "Ask Dispatch isn't connected yet — ask your teacher to set it up! In the meantime, I bet your teacher can answer this question brilliantly. 😊";
    }
    try {
      const res = await fetch(WORKER_URL, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ messages, system })
      });
      const data = await res.json();
      if (data.content && data.content[0]) return data.content[0].text;
      return 'Hmm, something went wrong! Try asking again. 🔄';
    } catch (e) {
      return 'Could not connect right now. Check your internet and try again! 🌐';
    }
  }

  function addAiMsg(text) {
    const box = document.getElementById('messages');
    const div = document.createElement('div');
    div.className = 'msg-ai-wrap';
    div.innerHTML = `<div class="msg-ai-avatar">📰</div><div class="msg-ai-bubble">${text}</div>`;
    box.appendChild(div);
    box.scrollTop = box.scrollHeight;
  }

  function addUserMsg(text) {
    const box = document.getElementById('messages');
    const div = document.createElement('div');
    div.className = 'msg-user-wrap';
    div.innerHTML = `<div class="msg-user-bubble">${text}</div>`;
    box.appendChild(div);
    box.scrollTop = box.scrollHeight;
  }

  function addTyping() {
    const box = document.getElementById('messages');
    const div = document.createElement('div');
    div.className = 'typing-wrap'; div.id = 'typing';
    div.innerHTML = '<div class="msg-ai-avatar">📰</div><div class="typing-bubble"><span></span><span></span><span></span></div>';
    box.appendChild(div);
    box.scrollTop = box.scrollHeight;
  }

  function removeTyping() {
    const t = document.getElementById('typing');
    if (t) t.remove();
  }
</script>
</body>
</html>
